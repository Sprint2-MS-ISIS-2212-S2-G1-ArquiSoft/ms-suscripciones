# Aplicacion
NODE_ENV=development
PORT=3000
SUSCRIPCIONES_NAME=suscripciones

# BD Suscripciones (PostgreSQL). DB_PORT=5439 es el puerto publicado por
# docker-compose.local.yml hacia el host; dentro de la red de compose es 5432.
DB_HOST=localhost
DB_PORT=5439
DB_USER=suscripciones
DB_PASSWORD=suscripciones
DB_NAME=suscripciones
DB_LOGGING=false

# true en local (crea las tablas). En AWS: false, el esquema lo crea database/init.sql.
DB_SYNCHRONIZE=true
# true en AWS: RDS PostgreSQL 16 exige SSL.
DB_SSL=false
# Conexiones maximas del pool POR REPLICA.
DB_POOL_MAX=15

# Microservicios vecinos. Nunca una IP ni un host escrito en el codigo.
EMISION_URL=http://localhost:3018
TERCEROS_URL=http://localhost:3017
# Permite desactivar la llamada externa a pagos si el experimento aisla Distribucion -> Suscripciones -> Emision.
PAGOS_HABILITADO=true

# ---- ASR de disponibilidad: Bulkhead + Timeout estricto 1500 ms + Failover idempotente ----
# false = linea base sin bulkhead, sin reintentos de conmutacion y timeout de 5000 ms.
RESILIENCIA_HABILITADA=true
# Timeout estricto hacia ms-emision (ms).
EMISION_TIMEOUT_MS=1500
# Tamano del pool HTTP dedicado (Bulkhead) hacia ms-emision.
BULKHEAD_CONEXIONES=20
# Maximo de peticiones simultaneas en vuelo hacia ms-emision.
BULKHEAD_CONCURRENCIA=30
# Reintentos idempotentes dentro del presupuesto de 1500 ms ante corte de replica.
EMISION_REINTENTOS=1
# Timeout hacia ms-terceros (ms).
TERCEROS_TIMEOUT_MS=1500
